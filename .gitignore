# Python
__pycache__/
*.pyc
*.pyo

# Virtual env
.venv/
venv/

# IDE
.idea/

# Generated reports / logs - these are run output, not source
report.csv
report.json
*.tmp
*.log
audit.log

# Per-project hashing salt. MUST NOT be committed: it is what stops the
# hashes in report.csv from being reversible via public rainbow tables.
.pwhygiene_salt

# Stray test artifacts (the suite now uses a tempdir, so these should
# never appear - kept as a backstop).
test_append_output*
verify*.csv
